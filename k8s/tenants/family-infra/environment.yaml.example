# Example family infrastructure environment configuration only.
# Replace all values locally before use.
# Do not commit real secrets, seal keys, or tokens.
# The seal key file must never be committed.
# The transit token must never be committed.
# Apps use Tenant OpenBao, not Global OpenBao.

environment_name: family-infra
tenant_id: family-infra-01
public_hostname: family.example.test
contact_email: admin@example.test
storage_class: local-path

global_openbao_transit:
  address: https://openbao-operator.example.test
  mount_path: transit
  key_name: family-infra-01-seal

tenant_openbao:
  namespace: family-infra
  service_name: openbao
