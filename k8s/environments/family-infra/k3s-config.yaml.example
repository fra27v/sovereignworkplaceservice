# Example k3s server configuration for the family-infra environment.
# Copy this file to /etc/rancher/k3s/config.yaml on the target node.
# Do not commit the real local /etc/rancher/k3s/config.yaml file.

cluster-init: true
node-name: family-infra

secrets-encryption: true
write-kubeconfig-mode: "0600"

disable:
  - traefik
  - servicelb

tls-san:
  - family-infra.internal
