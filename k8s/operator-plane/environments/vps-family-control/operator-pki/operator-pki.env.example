# Copy this file to operator-pki.env and keep the real file out of Git.
# The real operator-pki.env file is local bootstrap/recovery configuration.
# Keep it at 0600 permissions.
#
# Do not put secrets in this file.
# Do not put private keys, certificates, tokens, OpenBao init material, public
# IPs, real domains, or emails in this file.
#
# The Operator CA private key is generated and retained inside OpenBao.
# The public CA bundle is exported for trust distribution.
# The operator-vault leaf private key is generated only during issuance or
# rotation and will later be written safely to the runtime OpenBao TLS path.

OPENBAO_NAMESPACE=openbao-operator
OPENBAO_POD_NAME=openbao-global-0
OPENBAO_PKI_MOUNT=operator-pki
OPENBAO_OPERATOR_CA_COMMON_NAME=Sovereign Workplace Operator CA
OPENBAO_OPERATOR_CA_TTL=43800h
OPENBAO_OPERATOR_VAULT_ROLE=operator-vault
OPENBAO_OPERATOR_VAULT_COMMON_NAME=operator-vault.example.invalid
OPENBAO_OPERATOR_VAULT_ALT_NAMES=operator-vault.example.invalid,openbao-global,openbao-global.openbao-operator,openbao-global.openbao-operator.svc,openbao-global.openbao-operator.svc.cluster.local,localhost
OPENBAO_OPERATOR_VAULT_IP_SANS=127.0.0.1
OPENBAO_OPERATOR_VAULT_TTL=2160h
OPERATOR_PKI_PUBLIC_DIR=/var/lib/sovereignworkplaceservice/operator-pki/public
OPENBAO_TLS_DIR=/var/lib/sovereignworkplaceservice/openbao/tls
