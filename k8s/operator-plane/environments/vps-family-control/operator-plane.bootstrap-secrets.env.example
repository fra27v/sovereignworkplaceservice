# Copy this file to operator-plane.bootstrap-secrets.env before importing.
# Never commit the real file.
# Set file permissions to 0600.
# This file is import material only, not steady-state source of truth.
# After import, OpenBao KV is the source of truth.

# Traefik OVH DNS-01 credentials
OVH_ENDPOINT=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# operator-artifacts BasicAuth import inputs.
# These values are local import material only.
# The import script derives the final htpasswd-compatible users line on the host.
# OpenBao runtime KV stores only the final key: users.
# Username and token are not written to the operator-artifacts runtime KV path.
OPERATOR_ARTIFACTS_FAMILY_INFRA_01_USERNAME=
OPERATOR_ARTIFACTS_FAMILY_INFRA_01_TOKEN=
