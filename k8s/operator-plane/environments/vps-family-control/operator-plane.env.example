# Copy this file to operator-plane.env and keep the real file out of Git.
# Set operator-plane.env permissions to 0600.
#
# This is the only normal operational env file for vps-family-control.
# Component-specific .env.example files, if kept, are reference-only and must
# not introduce independent real env files.
#
# Do not put secrets in this file.
# Do not put private keys, certificates, tokens, OpenBao init material, public
# IPs, real domains, or emails in this file.
#
# Do not duplicate values. Derive service FQDNs and internal DNS names from
# stable component names, namespace names, and OPERATOR_DOMAIN where possible.
# Bootstrap/import/recovery secret material belongs in explicit bootstrap files
# or OpenBao KV, not in additional component env files.

# Central base domain for operator-plane public service names.
# Public hostnames such as operator-vault.${OPERATOR_DOMAIN} and
# operator-artifacts.${OPERATOR_DOMAIN} are derived from this value.
OPERATOR_DOMAIN=example.invalid

# Kubernetes/OpenBao service identity. These values are independent because
# they identify in-cluster objects, not public DNS names.
KUBERNETES_CLUSTER_DNS_SUFFIX=cluster.local
OPENBAO_NAMESPACE=openbao-operator
OPENBAO_POD_NAME=openbao-global-0
OPENBAO_SERVICE_NAME=openbao-global

# Path to the existing local Global OpenBao init JSON. This is a path only,
# not the secret itself. The file it points to contains sensitive OpenBao init
# material, including bootstrap token and recovery material. Do not paste or
# commit the real file contents, and do not duplicate the init file under
# /root. Real operator-plane.env should set this path to the existing local
# bootstrap init file for the operator user.
OPENBAO_BOOTSTRAP_INIT_FILE=/home/ubuntu/openbao-bootstrap/openbao-global/openbao-global-init.json

# Operator PKI foundation. The common name and DNS SANs for operator-vault are
# derived by scripts from OPERATOR_DOMAIN, OPENBAO_SERVICE_NAME,
# OPENBAO_NAMESPACE, and KUBERNETES_CLUSTER_DNS_SUFFIX.
OPENBAO_PKI_MOUNT=operator-pki
OPENBAO_OPERATOR_CA_COMMON_NAME=Sovereign Workplace Operator CA
OPENBAO_OPERATOR_CA_TTL=43800h
OPENBAO_OPERATOR_VAULT_ROLE=operator-vault
OPENBAO_OPERATOR_VAULT_TTL=2160h
OPENBAO_OPERATOR_VAULT_IP_SANS=127.0.0.1
OPERATOR_PKI_PUBLIC_DIR=/var/lib/sovereignworkplaceservice/operator-pki/public
OPENBAO_TLS_DIR=/var/lib/sovereignworkplaceservice/openbao/tls

# operator-artifacts operational configuration.
# The public hostname is derived as operator-artifacts.${OPERATOR_DOMAIN}.
# The BasicAuth username is derived from OPERATOR_ARTIFACTS_TENANT_NAME.
# Do not add real public IPs to this example.
OPERATOR_ARTIFACTS_LOCAL_ROOT=/var/lib/sovereignworkplaceservice/operator-artifacts
OPERATOR_ARTIFACTS_PUBLIC_DIR=/var/lib/sovereignworkplaceservice/operator-artifacts/public
OPERATOR_ARTIFACTS_PRIVATE_DIR=/var/lib/sovereignworkplaceservice/operator-artifacts/private
OPERATOR_ARTIFACTS_TENANT_NAME=family-infra-01
OPERATOR_ARTIFACTS_ALLOWED_SOURCE_RANGES="127.0.0.1/32,::1/128,<home-public-ip>/32"
