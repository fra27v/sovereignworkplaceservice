# Ignore real local secret material for this OpenBao environment.
*

# Keep documentation and sanitized examples trackable.
!.gitignore
!README.md
!openbao-global.versions.env
!*/
!*.example
!**/*.example
!values/
!values/*.yaml
!scripts/
!scripts/*.sh
!scripts/lib/
!scripts/lib/*.sh
!manifests/
!manifests/*.yaml
!tests/
!tests/*.sh
