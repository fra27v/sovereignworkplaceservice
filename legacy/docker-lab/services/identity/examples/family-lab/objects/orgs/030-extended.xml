    <targetRef oid="aaaaaaaa-aaaa-aaaa-aaaa-000000000001" type="OrgType"/>
    <!-- Parent is Family -->
  </assignment>

  <inducement>
      <targetRef oid="bbbbbbbb-bbbb-bbbb-bbbb-000000000042" type="RoleType"/>
      <!-- This is the role that represents IdP group membership /extended. -->
