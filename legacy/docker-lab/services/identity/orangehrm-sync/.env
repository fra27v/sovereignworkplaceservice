MIDPOINT_BASE_URL=https://identity.internal/midpoint

DB_HOST=orangehrm-db
DB_PORT=3306
DB_NAME=orangehrm

DB_USER_FILE=/secrets/orangehrm_db_username
DB_PASSWORD_FILE=/secrets/orangehrm_db_password

MIDPOINT_USERNAME=administrator
MIDPOINT_PASSWORD_FILE=/secrets/midpoint_adm_password

REQUESTS_CA_BUNDLE=/ca/internal-ca.crt

DRY_RUN=false
LOG_LEVEL=INFO
SYNC_INTERVAL_SECONDS=300

ORG_MAPPING_FILE=/app/org-mapping.json